# Copy this file to .env and adjust the values for your local MySQL
# server. All of these already have working defaults baked into the
# code, so creating a .env is optional — the app runs with zero setup
# if you skip this file entirely.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=fastapi_learn

# Set this to override everything above at once — e.g. point at SQLite
# for a quick local try with no MySQL server running at all.
# DATABASE_URL=sqlite:///./test.db

# The key that encrypts and decrypts phone/notes. Generate your own:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it secret and OUT OF GIT. Lose it and every encrypted value is
# gone for good. Change it and existing rows can no longer be decrypted.
# Leave it unset to use the dev-only key hardcoded in config.py.
# FERNET_KEY=
