# Copy this file to .env and adjust the values. Every setting below has
# a working development default baked into config.py, so creating a
# .env is optional — the app runs with zero setup if you skip it.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=fastapi_learn

# Set this to override everything above at once — e.g. point at SQLite
# for a quick local try with no MySQL server running at all.
# DATABASE_URL=sqlite:///./test.db

# Signs every JWT. The built-in default is fine for development, but
# with ENVIRONMENT=production the app REFUSES TO START unless you set a
# real one (32+ characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# "development" (default) or "production". Production also turns off
# /docs, /redoc and /openapi.json.
# ENVIRONMENT=development

# Short-lived access tokens, longer-lived refresh tokens.
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7

# Which browser origins may call this API (a JSON list).
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# How many POST /token attempts one IP gets (slowapi syntax).
# LOGIN_RATE_LIMIT=5/minute
