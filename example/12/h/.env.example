# Copy this file to .env and adjust the values for your local MySQL
# server. All of these already have working defaults baked into the
# code, so creating a .env is optional — the app runs with zero setup
# if you skip this file entirely.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=fastapi_learn

# Set this to override everything above at once — e.g. point at SQLite
# for a quick local try with no MySQL server running at all.
# DATABASE_URL=sqlite:///./test.db

# The alphabet sqids uses to build public ids. Shuffling it gives your
# app its own ids (it works like a salt). Every character must be
# unique, at least 3 characters. Pick it ONCE: changing it later changes
# every public id and breaks every link anyone has saved. To make your own:
#   python -c "import random,string; a=list(string.ascii_letters+string.digits); random.shuffle(a); print(''.join(a))"
# SQIDS_ALPHABET=DpNyH4T2PcXBCbfRnV8s6qg7kwrhAOGLKQ0Uaot1ix9zvSjZMEuldWeFIYJm35
