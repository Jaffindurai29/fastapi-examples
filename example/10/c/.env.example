# Copy this file to .env and adjust the values. Every one of these has a
# working default in config.py, so creating a .env is optional — the
# app runs with zero setup if you skip this file entirely.
#
# Names are case-insensitive: MYSQL_HOST fills the mysql_host field.
# A real environment variable beats the same name in this file.

APP_NAME=Structured Items API
# true/false, 1/0, yes/no, on/off all work.
DEBUG=false

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=fastapi_learn

# Set this to override every MYSQL_* value above at once — e.g. point
# at SQLite for a quick local try with no MySQL server running at all.
# DATABASE_URL=sqlite:///./test.db

# The key clients must send in the X-API-Key header for POST, PATCH and
# DELETE. Change it for anything that isn't your own laptop.
API_KEY=dev-api-key

# A JSON list of browser origins allowed to call the API (CORS).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
